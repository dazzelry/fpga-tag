    end
  end



  // ---------------- color output ----------------
  always_ff@(posedge vga_clock, negedge reset_n) begin
    if (!reset_n) begin
      {red, green, blue} <= 24'hff_ff_ff;
    end else begin
      // for pikachu image
      if (((hcount>=pika_start_x)&&(hcount<pika_start_x+64)) 
            && ((vcount>=pika_start_y)&&(vcount<pika_start_y+64)))
        
        // TODO
        {red, green, blue} <= ;
      // for background
      else
        //TODO
        {red, green, blue} <= ;
    end
  end



  // ---------------- FSM, classic three-block style ----------------
  // Two states are enough: sitting still, or taking one jump.
  localparam [0:0] S_IDLE = 1'b0, S_MOVE = 1'b1;
  logic cur_state, next_state;



  // ---- block 1: state register - remember where we are ----
  always_ff@(posedge vga_clock, negedge reset_n) begin
    if (!reset_n)
      cur_state <= S_IDLE;
    else
      cur_state <= next_state;
  end



  // ---- block 2: next-state logic - decide where to go ----
  always_comb begin
    case (cur_state)
			 // TODO: what is the next state, what is the transit condition?
      S_IDLE:  next_state = ;
      S_MOVE:  next_state = ;             
      default: next_state = S_IDLE;
    endcase
  end



  // ---- block 3: datapath - what happens in each state ----

	localparam int MOVE = 40;     // pixels per attack(move) press
  always_ff@(posedge vga_clock, negedge reset_n) begin
    if (!reset_n) begin
			 // TODO:
      pika_start_x <= ;
      pika_start_y <= ;
    end else if (cmd_restart) begin
			 // TODO: restart the location
      pika_start_x <= ;             
    end else if (cur_state == S_MOVE) begin
			 // TODO: let pikachi jump left
      pika_start_x <= ;      
    end
  end



endmodule